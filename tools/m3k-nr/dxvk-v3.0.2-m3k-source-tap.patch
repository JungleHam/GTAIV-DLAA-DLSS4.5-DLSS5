+static std::mutex g_m3kPresentSourceMutex;
+static M3KPresentSourceV1 g_m3kPresentSource = { sizeof(M3KPresentSourceV1), 1u };
+
+extern "C" __declspec(dllexport) int __cdecl M3K_QueryPresentSourceV1(M3KPresentSourceV1* out) {
+  if (!out || out->size < sizeof(M3KPresentSourceV1))
+    return 0;
+
+  std::lock_guard<std::mutex> lock(g_m3kPresentSourceMutex);
+  if (!g_m3kPresentSource.sequence)
+    return 0;
+
+  *out = g_m3kPresentSource;
+  return 1;
+}

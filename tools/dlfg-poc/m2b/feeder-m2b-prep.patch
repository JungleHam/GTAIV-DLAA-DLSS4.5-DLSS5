+// C ABI shared with the independently-built OptiScaler fork. Handles are 64-bit
+// Vulkan non-dispatchable values except VkDevice, but all are naturally ABI-safe
+// in this x64 process. Version and size permit append-only evolution.
+struct Dlss5M3b1aPublishedFrame
+{
+    uint32_t abiVersion;
+    uint32_t structSize;
+    uint64_t serial;
+    uint32_t ready;
+    uint32_t reserved;
+    VkDevice device;
+    VkImage image;
+    VkFormat format;
+    uint32_t width;
+    uint32_t height;
+    VkSemaphore producerTimeline;
+    uint64_t producerReadyValue;
+    VkImageLayout externalRestingLayout;
+    uint64_t sourceFrame;
+};
+
+static SRWLOCK g_m3b1a_lock = SRWLOCK_INIT;
+static Dlss5M3b1aPublishedFrame g_m3b1a_publication = {};
+
+extern "C" __declspec(dllexport) BOOL WINAPI DLSS5_QueryM3B1AExternalFrame(Dlss5M3b1aPublishedFrame *out)
+{
+    if (out == nullptr) return FALSE;
+    AcquireSRWLockShared(&g_m3b1a_lock);
+    *out = g_m3b1a_publication;
+    const BOOL ready = out->abiVersion == 1 && out->structSize == sizeof(*out) && out->ready != 0;
+    ReleaseSRWLockShared(&g_m3b1a_lock);
+    return ready;
+}
+
+extern "C" __declspec(dllexport) BOOL WINAPI DLSS5_ConsumeM3B1AExternalFrame(uint64_t serial)
+{
+    AcquireSRWLockExclusive(&g_m3b1a_lock);
+    const BOOL matched = g_m3b1a_publication.ready != 0 && g_m3b1a_publication.serial == serial;
+    if (matched) g_m3b1a_publication.ready = 0;
+    ReleaseSRWLockExclusive(&g_m3b1a_lock);
+    if (matched) Log("[feed] M3B-1A consumer acknowledged serial=%llu", static_cast<unsigned long long>(serial));
+    return matched;
+}
+
+// Leaves the proven frame ABI unchanged while letting the consumer distinguish
+// the M3B-1 native feature-11 producer from the M3B-1A copy producer. This is
+// queried before Consume clears ready and is never accepted as proof by itself.
+extern "C" __declspec(dllexport) BOOL WINAPI DLSS5_IsM3B1GeneratedFrame(uint64_t serial)
+{
+    AcquireSRWLockShared(&g_m3b1a_lock);
+    const BOOL genuine = g_m3b1a_publication.ready != 0 &&
+                         g_m3b1a_publication.serial == serial &&
+                         g.m3b1_genuine_serial == serial;
+    ReleaseSRWLockShared(&g_m3b1a_lock);
+    return genuine;
+}
+
+static uint64_t PublishM3bExternalFrame(UINT64 source_frame, UINT64 ready_value, bool genuine)
+{
+    Dlss5M3b1aPublishedFrame publication = {};
+    publication.abiVersion = 1;
+    publication.structSize = sizeof(publication);
+    publication.serial = ++g.m3b1a_serial;
+    publication.ready = 1;
+    publication.device = g.vk.dev;
+    publication.image = g.m3b1a_vk_img;
+    publication.format = VK_FORMAT_B8G8R8A8_UNORM;
+    publication.width = g.width;
+    publication.height = g.height;
+    publication.producerTimeline = g.vk_sem_out;
+    publication.producerReadyValue = ready_value;
+    publication.externalRestingLayout = VK_IMAGE_LAYOUT_GENERAL;
+    publication.sourceFrame = source_frame;
+    AcquireSRWLockExclusive(&g_m3b1a_lock);
+    g.m3b1_genuine_serial = genuine ? publication.serial : 0;
+    g_m3b1a_publication = publication;
+    ReleaseSRWLockExclusive(&g_m3b1a_lock);
+    g.m3b1a_published = true;
+    return publication.serial;
+}

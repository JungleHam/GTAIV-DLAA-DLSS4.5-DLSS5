+static const int kM2bIdle = 0, kM2bHistory = 1, kM2bReadbackPending = 2,
+                 kM2bPassed = 3, kM2bFailed = 4;
+static const int kM2cIdle = 0, kM2cPrearmed = 1, kM2cWaitingArmed = 2,
+                 kM2cEvaluating = 3, kM2cPassed = 4, kM2cFailed = 5;
+
+static const char *DlfgOwnerTag()
+{
+    return g.dlfg_owner == 2 ? "M3B-1" : g.dlfg_owner == 1 ? "M2C" : "M2B";
+}
+
+static void M2bFail(const char *why)
+{
+    if (g.dlfg_state == kM2bFailed || g.dlfg_state == kM2bPassed) return;
+    g.dlfg_state = kM2bFailed;
+    if (g.dlfg_owner == 1) g.m2c_state = kM2cFailed;
+    Log("[feed] %s: FAILED: %s", DlfgOwnerTag(), why);
+}
+
+static void M2bReleaseFeature()
+{
+    if (g.dlfg_feature == nullptr) return;
+    __try
+    {
+        const NVSDK_NGX_Result r = NVSDK_NGX_D3D12_ReleaseFeature(g.dlfg_feature);
+        if (NVSDK_NGX_FAILED(r)) Log("[feed] M2B: ReleaseFeature -> 0x%08X (%s)", r, NgxResultName(r));
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER)
+    { Log("[feed] M2B: ReleaseFeature raised exception 0x%08X (ignored during teardown)", GetExceptionCode()); }
+    g.dlfg_feature = nullptr;
+}
+
+static void M2bRelease()
+{
+    // Release before the per-build shared resources: the feature's parameter bindings
+    // point into tex12. This never calls NGX Init/Shutdown; that lifecycle remains the
+    // Feeder's one established by SafeNgxInit12.
+    if (g.dlfg_feature != nullptr)
+    {
+        if (!g_ngx_dying) M2bReleaseFeature();
+        else g.dlfg_feature = nullptr;
+    }
+    if (g.dlfg_params != nullptr)
+    {
+        if (!g_ngx_dying)
+        {
+            const NVSDK_NGX_Result r = NVSDK_NGX_D3D12_DestroyParameters(g.dlfg_params);
+            if (NVSDK_NGX_FAILED(r)) Log("[feed] M2B: DestroyParameters -> 0x%08X (%s)", r, NgxResultName(r));
+        }
+        g.dlfg_params = nullptr;
+    }
+    SafeRelease(g.dlfg_output);
+    SafeRelease(g.dlfg_prev_readback);
+    SafeRelease(g.dlfg_curr_readback);
+    SafeRelease(g.dlfg_output_readback);
+    g.dlfg_footprint = {};
+    g.dlfg_readback_bytes = 0;
+    g.dlfg_readback_fence = 0;
+    g.dlfg_history_frame = 0;
+    g.dlfg_last_skip_frame = 0;
+    g.dlfg_state = kM2bIdle;
+    g.dlfg_owner = 0;
+    if (!g.m2c_evaluation_attempted)
+    {
+        // A resource rebuild releases the retained feature/history. A later M2C create
+        // is permitted only through the same pre-ARMED policy, never after DFC is ARMED.
+        g.m2c_state = kM2cIdle;
+        g.m2c_prearm_dfc_state = DFC_STATE_UNKNOWN;
+        g.m2c_dfc_detected = false;
+        g.m2c_armed_seen = false;
+    }
+    g_m2b_depth_valid = false;
+}
+
+static bool M2bCreateReadback(ID3D12Resource **out)
+{
+    D3D12_HEAP_PROPERTIES hp = {}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    rd.Width = g.dlfg_readback_bytes;
+    rd.Height = 1;
+    rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1;
+    rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    const HRESULT hr = g.dev12->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd,
+        D3D12_RESOURCE_STATE_COPY_DEST, nullptr, __uuidof(ID3D12Resource),
+        reinterpret_cast<void **>(out));
+    if (FAILED(hr))
+    {
+        Log("[feed] M2B: CreateCommittedResource(readback) failed 0x%08X (%s)", hr, FeedHrName(hr));
+        return false;
+    }
+    return true;
+}
+
+static bool M2bCreateResources()
+{
+    D3D12_HEAP_PROPERTIES hp = {}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = g.width;
+    rd.Height = g.height;
+    rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1;
+    rd.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    HRESULT hr = g.dev12->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd,
+        D3D12_RESOURCE_STATE_COMMON, nullptr, __uuidof(ID3D12Resource),
+        reinterpret_cast<void **>(&g.dlfg_output));
+    if (FAILED(hr))
+    {
+        Log("[feed] M2B: CreateCommittedResource(private interpolated output) failed 0x%08X (%s)",
+            hr, FeedHrName(hr));
+        return false;
+    }
+    UINT rows = 0; UINT64 row_bytes = 0;
+    g.dev12->GetCopyableFootprints(&rd, 0, 1, 0, &g.dlfg_footprint, &rows, &row_bytes, &g.dlfg_readback_bytes);
+    if (g.dlfg_readback_bytes == 0 || g.dlfg_footprint.Footprint.RowPitch < g.width * 4u ||
+        !M2bCreateReadback(&g.dlfg_prev_readback) || !M2bCreateReadback(&g.dlfg_curr_readback) ||
+        !M2bCreateReadback(&g.dlfg_output_readback))
+        return false;
+    Log("[feed] M2B: private output/readback created: %ux%u B8G8R8A8, row pitch %u, %llu bytes",
+        g.width, g.height, g.dlfg_footprint.Footprint.RowPitch,
+        static_cast<unsigned long long>(g.dlfg_readback_bytes));
+    return true;
+}
+
+static bool M3b1CreateReadbacks()
+{
+    if (g.m3b1a_tex12 == nullptr) return false;
+    const D3D12_RESOURCE_DESC rd = g.m3b1a_tex12->GetDesc();
+    UINT rows = 0; UINT64 row_bytes = 0;
+    g.dev12->GetCopyableFootprints(&rd, 0, 1, 0, &g.dlfg_footprint, &rows, &row_bytes,
+                                   &g.dlfg_readback_bytes);
+    if (g.dlfg_readback_bytes == 0 || g.dlfg_footprint.Footprint.RowPitch < g.width * 4u ||
+        !M2bCreateReadback(&g.dlfg_prev_readback) || !M2bCreateReadback(&g.dlfg_curr_readback) ||
+        !M2bCreateReadback(&g.dlfg_output_readback))
+        return false;
+    Log("[feed] M3B-1: validation readbacks created: %ux%u B8G8R8A8 rowPitch=%u bytes=%llu",
+        g.width, g.height, g.dlfg_footprint.Footprint.RowPitch,
+        static_cast<unsigned long long>(g.dlfg_readback_bytes));
+    return true;
+}
+
+static bool M2bCheckCapabilities()
+{
+    NVSDK_NGX_Parameter *caps = nullptr;
+    const NVSDK_NGX_Result r = NVSDK_NGX_D3D12_GetCapabilityParameters(&caps);
+    if (NVSDK_NGX_FAILED(r) || caps == nullptr)
+    {
+        Log("[feed] M2B: GetCapabilityParameters(FrameGeneration) -> 0x%08X (%s)", r, NgxResultName(r));
+        return false;
+    }
+    int available = 0, needs_driver = 1;
+    unsigned int max_count = 0;
+    const NVSDK_NGX_Result ra = caps->Get(NVSDK_NGX_Parameter_FrameGeneration_Available, &available);
+    const NVSDK_NGX_Result rd = caps->Get(NVSDK_NGX_Parameter_FrameGeneration_NeedsUpdatedDriver, &needs_driver);
+    const NVSDK_NGX_Result rm = caps->Get(NVSDK_NGX_DLSSG_Parameter_MultiFrameCountMax, &max_count);
+    Log("[feed] M2B: FrameGeneration.Available=%d (0x%08X), NeedsUpdatedDriver=%d (0x%08X), "
+        "DLSSG.MultiFrameCountMax=%u (0x%08X)", available, ra, needs_driver, rd, max_count, rm);
+    const NVSDK_NGX_Result rx = NVSDK_NGX_D3D12_DestroyParameters(caps);
+    if (NVSDK_NGX_FAILED(rx))
+        Log("[feed] M2B: DestroyParameters(capabilities) -> 0x%08X (%s)", rx, NgxResultName(rx));
+    return NVSDK_NGX_SUCCEED(ra) && NVSDK_NGX_SUCCEED(rd) && NVSDK_NGX_SUCCEED(rm) &&
+           NVSDK_NGX_SUCCEED(rx) && available != 0 && needs_driver == 0 && max_count >= 1;
+}
+
+static bool M3b1CheckCapabilities()
+{
+    NVSDK_NGX_Parameter *caps = nullptr;
+    const NVSDK_NGX_Result r = NVSDK_NGX_D3D12_GetCapabilityParameters(&caps);
+    if (NVSDK_NGX_FAILED(r) || caps == nullptr)
+    {
+        Log("[feed] M3B-1: GetCapabilityParameters -> 0x%08X (%s)", r, NgxResultName(r));
+        return false;
+    }
+    int available = 0, needs_driver = 1;
+    unsigned int max_count = 0;
+    const NVSDK_NGX_Result ra = caps->Get(NVSDK_NGX_Parameter_FrameGeneration_Available, &available);
+    const NVSDK_NGX_Result rd = caps->Get(NVSDK_NGX_Parameter_FrameGeneration_NeedsUpdatedDriver, &needs_driver);
+    const NVSDK_NGX_Result rm = caps->Get(NVSDK_NGX_DLSSG_Parameter_MultiFrameCountMax, &max_count);
+    Log("[feed] M3B-1: DLSS-G capability Available=%d NeedsUpdatedDriver=%d MultiFrameCountMax=%u",
+        available, needs_driver, max_count);
+    const NVSDK_NGX_Result rx = NVSDK_NGX_D3D12_DestroyParameters(caps);
+    return NVSDK_NGX_SUCCEED(ra) && NVSDK_NGX_SUCCEED(rd) && NVSDK_NGX_SUCCEED(rm) &&
+           NVSDK_NGX_SUCCEED(rx) && available != 0 && needs_driver == 0 && max_count >= 1;
+}
+
+static NVSDK_NGX_Result SafeCreateDLFG(NVSDK_NGX_DLSSG_Create_Params *cp, DWORD *code)
+{
+    *code = 0;
+    if (NgxRefuse("DLSS-G create")) return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF);
+    __try
+    {
+        return NGX_D3D12_CREATE_DLSSG(g.list, 1, 1, &g.dlfg_feature, g.dlfg_params, cp);
+    }
+    __except (NoteNgxFault("DLSS-G CreateFeature", GetExceptionInformation()), EXCEPTION_EXECUTE_HANDLER)
+    { *code = GetExceptionCode(); return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+}
+
+static NVSDK_NGX_Result SafeEvaluateDLFG(NVSDK_NGX_D3D12_DLSSG_Eval_Params *ep,
+                                         NVSDK_NGX_DLSSG_Opt_Eval_Params *op, DWORD *code)
+{
+    *code = 0;
+    if (NgxRefuse("DLSS-G evaluate")) return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF);
+    __try
+    {
+        return NGX_D3D12_EVALUATE_DLSSG(g.list, g.dlfg_feature, g.dlfg_params, ep, op);
+    }
+    __except (NoteNgxFault("DLSS-G EvaluateFeature", GetExceptionInformation()), EXCEPTION_EXECUTE_HANDLER)
+    { *code = GetExceptionCode(); return static_cast<NVSDK_NGX_Result>(0x7FFFFFFF); }
+}
+
+static void M2bIdentity(float m[4][4])
+{
+    memset(m, 0, sizeof(float) * 16);
+    m[0][0] = m[1][1] = m[2][2] = m[3][3] = 1.0f;
+}
+
+static void M2bBuildConstants(NVSDK_NGX_DLSSG_Opt_Eval_Params *op, bool reset)
+{
+    *op = {};
+    const float near_z = 0.1f, far_z = 1000.0f, fov = 1.0471975512f; // 60 degrees
+    const float aspect = static_cast<float>(g.width) / static_cast<float>(g.height);
+    const float f = 1.0f / tanf(fov * 0.5f);
+    const float a = far_z / (far_z - near_z);
+    const float b = -near_z * far_z / (far_z - near_z);
+    // Row-major D3D perspective and its exact inverse. No TAA jitter is baked in.
+    op->cameraViewToClip[0][0] = f / aspect;
+    op->cameraViewToClip[1][1] = f;
+    op->cameraViewToClip[2][2] = a;
+    op->cameraViewToClip[2][3] = 1.0f;
+    op->cameraViewToClip[3][2] = b;
+    op->clipToCameraView[0][0] = aspect / f;
+    op->clipToCameraView[1][1] = 1.0f / f;
+    op->clipToCameraView[2][3] = 1.0f / b;
+    op->clipToCameraView[3][2] = 1.0f;
+    op->clipToCameraView[3][3] = -a / b;
+    M2bIdentity(op->clipToLensClip);
+    M2bIdentity(op->clipToPrevClip);
+    M2bIdentity(op->prevClipToClip);
+    op->multiFrameCount = 1;
+    op->multiFrameIndex = 1;
+    // SLOT_MV stores pixel-space motion, so DLSS-G needs pixel -> normalized
+    // conversion. These are deliberately independent from the Feeder's DLAA
+    // mv_scale_x/y contract and must not change that existing behavior.
+    op->mvecScale[0] = 1.0f / static_cast<float>(g.width);
+    op->mvecScale[1] = 1.0f / static_cast<float>(g.height);
+    op->cameraUp[1] = 1.0f;
+    op->cameraRight[0] = 1.0f;
+    op->cameraFwd[2] = 1.0f;
+    op->cameraNear = near_z;
+    op->cameraFar = far_z;
+    op->cameraFOV = fov;
+    op->cameraAspectRatio = aspect;
+    op->colorBuffersHDR = false;
+    op->depthInverted = g_cfg.depth_inverted >= 0 ? g_cfg.depth_inverted != 0 : g.depth_reversed;
+    op->cameraMotionIncluded = true;
+    op->reset = reset;
+    op->automodeOverrideReset = false;
+    op->notRenderingGameFrames = false;
+    op->orthoProjection = false;
+    op->motionVectorsInvalidValue = 0.0f;
+    op->motionVectorsDilated = false;
+    op->menuDetectionEnabled = false;
+    const NVSDK_NGX_Dimensions full = { g.width, g.height };
+    op->mvecsSubrectSize = op->depthSubrectSize = op->hudLessSubrectSize = full;
+    op->uiSubrectSize = op->uiAlphaSubrectSize = op->bidirectionalDistFieldSubrectSize = full;
+    op->backbufferSubrectSize = op->outputInterpSubrectSize = op->outputRealSubrectSize = full;
+}
+
+static void M2bCopyTextureToReadback(ID3D12Resource *src, ID3D12Resource *dst,
+                                     D3D12_RESOURCE_STATES state)
+{
+    Barrier(src, state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION from = {};
+    from.pResource = src; from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_TEXTURE_COPY_LOCATION to = {};
+    to.pResource = dst; to.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    to.PlacedFootprint = g.dlfg_footprint;
+    g.list->CopyTextureRegion(&to, 0, 0, 0, &from, nullptr);
+    Barrier(src, D3D12_RESOURCE_STATE_COPY_SOURCE, state);
+}
+
+static bool M2bRecordEval(UINT64 frame, bool reset, const char *tag)
+{
+    NVSDK_NGX_D3D12_DLSSG_Eval_Params ep = {};
+    // This is the post-DLAA/DFC resolved output. pOutputRealFrame deliberately stays null:
+    // DLSS-G has no permission to mutate the Feeder's normal game output in this milestone.
+    ep.pBackbuffer = g.tex12[SLOT_OUTPUT];
+    ep.pDepth = g.tex12[SLOT_DEPTH];
+    ep.pMVecs = g.tex12[SLOT_MV];
+    ep.pOutputInterpFrame = g.dlfg_output;
+    NVSDK_NGX_DLSSG_Opt_Eval_Params op = {};
+    M2bBuildConstants(&op, reset);
+    DWORD code = 0;
+    const NVSDK_NGX_Result r = SafeEvaluateDLFG(&ep, &op, &code);
+    if (code != 0)
+    {
+        Log("[feed] %s: DLSS-G evaluate raised exception 0x%08X; command list will not execute", tag, code);
+        M2bFail("DLSS-G evaluate raised an exception");
+        return false;
+    }
+    if (g.dlfg_owner != 0)
+        Log("[feed] M2C: reset=%d -> NGX_D3D12_EVALUATE_DLSSG(frame %llu) 0x%08X (%s)",
+            reset ? 1 : 0, static_cast<unsigned long long>(frame), r, NgxResultName(r));
+    else
+        Log("[feed] %s: NGX_D3D12_EVALUATE_DLSSG(frame %llu, reset=%d) -> 0x%08X (%s)",
+            tag, static_cast<unsigned long long>(frame), reset ? 1 : 0, r, NgxResultName(r));
+    if (NVSDK_NGX_FAILED(r)) { M2bFail("NGX_D3D12_EVALUATE_DLSSG failed"); return true; }
+    return true;
+}
+
+// Returns false only after an SEH fault recorded half-written NGX commands. The caller
+// aborts that list (the same containment rule used by the existing DLAA path).
+static bool M2bMaybeRecord(UINT64 frame, bool dlss_reset)
+{
+    if (g_cfg.dlfg_m2b_eval == 0 || g.dlfg_state == kM2bPassed || g.dlfg_state == kM2bFailed ||
+        g.dlfg_state == kM2bReadbackPending) return true;
+    if (g.width != 2560 || g.height != 1440 || g.color_fmt != DXGI_FORMAT_B8G8R8A8_UNORM ||
+        g.output_fmt != DXGI_FORMAT_B8G8R8A8_UNORM || g.tex12[SLOT_OUTPUT] == nullptr ||
+        g.tex12[SLOT_DEPTH] == nullptr || g.tex12[SLOT_MV] == nullptr || g.feature == nullptr ||
+        !g.ngx_inited)
+    {
+        M2bFail("required existing D3D12 NGX/session resources are not the validated 2560x1440 B8/R32/R16G16 set");
+        return true;
+    }
+    if (!g_m2b_depth_valid)
+    {
+        if (g.dlfg_last_skip_frame == 0 || frame - g.dlfg_last_skip_frame >= 300)
+        {
+            g.dlfg_last_skip_frame = frame;
+            Log("[feed] M2B: skipping DLSS-G: depth invalid/flat (wait for the existing 600-frame real-depth probe)");
+        }
+        return true;
+    }
+    if (g.dlfg_feature == nullptr)
+    {
+        if (!M2bCheckCapabilities()) { M2bFail("FrameGeneration is unavailable, needs a driver, or does not support one generated frame"); return true; }
+        if (!M2bCreateResources()) { M2bFail("could not allocate private DLSS-G output/readback resources"); return true; }
+        const NVSDK_NGX_Result ap = NVSDK_NGX_D3D12_AllocateParameters(&g.dlfg_params);
+        if (NVSDK_NGX_FAILED(ap) || g.dlfg_params == nullptr)
+        {
+            M2bFail("NVSDK_NGX_D3D12_AllocateParameters for DLSS-G failed");
+            return true;
+        }
+        NVSDK_NGX_DLSSG_Create_Params cp = {};
+        cp.Width = cp.RenderWidth = g.width;
+        cp.Height = cp.RenderHeight = g.height;
+        cp.NativeBackbufferFormat = static_cast<unsigned>(DXGI_FORMAT_B8G8R8A8_UNORM);
+        cp.DynamicResolutionScaling = false;
+        DWORD ccode = 0;
+        const NVSDK_NGX_Result cr = SafeCreateDLFG(&cp, &ccode);
+        if (ccode != 0)
+        {
+            Log("[feed] M2B: NGX_D3D12_CREATE_DLSSG raised exception 0x%08X; command list will not execute", ccode);
+            g.dlfg_feature = nullptr; // NGX may have written a partial handle before the exception
+            M2bFail("NGX_D3D12_CREATE_DLSSG raised an exception");
+            return false;
+        }
+        Log("[feed] M2B: NGX_D3D12_CREATE_DLSSG -> 0x%08X (%s), feature=%p (existing D3D12 NGX session)",
+            cr, NgxResultName(cr), (void *)g.dlfg_feature);
+        if (NVSDK_NGX_FAILED(cr) || g.dlfg_feature == nullptr) { M2bFail("NGX_D3D12_CREATE_DLSSG failed"); return true; }
+        Log("[feed] M2B: armed; camera mode=approximate (no GTA camera export), FOV=60deg near=0.1 far=1000; "
+            "MV source = pixel-space current-to-previous (DLSS5_Feed.fx: prev_uv = uv + mv); "
+            "DLSS-G mvecScale = 1/width, 1/height = %.9f,%.9f",
+            1.0f / static_cast<float>(g.width), 1.0f / static_cast<float>(g.height));
+    }
+
+    // Post-DLAA output started as UAV. Copy the surrounding real frame first, then make
+    // it a read-only DLSS-G input. Depth/MV are already NON_PIXEL_SHADER_RESOURCE.
+    if (g.dlfg_state == kM2bIdle || dlss_reset)
+    {
+        if (g.dlfg_state == kM2bHistory && dlss_reset)
+            Log("[feed] M2B: Feeder reset interrupted temporal history; re-arming history on frame %llu",
+                static_cast<unsigned long long>(frame));
+        M2bCopyTextureToReadback(g.tex12[SLOT_OUTPUT], g.dlfg_prev_readback, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        Barrier(g.dlfg_output, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        if (!M2bRecordEval(frame, true, "M2B")) return false;
+        Barrier(g.dlfg_output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+        Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        if (g.dlfg_state != kM2bFailed) { g.dlfg_state = kM2bHistory; g.dlfg_history_frame = frame; Log("[feed] M2B: first real frame accepted as temporal history"); }
+        return true;
+    }
+
+    // The next valid real frame is the sole interpolation request. It is not submitted
+    // separately: the existing D3D12 queue/fence sequence executes and retires it.
+    M2bCopyTextureToReadback(g.tex12[SLOT_OUTPUT], g.dlfg_curr_readback, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Barrier(g.dlfg_output, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    if (!M2bRecordEval(frame, false, "M2B")) return false;
+    if (g.dlfg_state != kM2bFailed)
+    {
+        M2bCopyTextureToReadback(g.dlfg_output, g.dlfg_output_readback, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        Log("[feed] M2B: output copied to CPU readback; awaiting existing D3D12 fence");
+        g.dlfg_readback_fence = g.fence_value + 1; // exactly the fence signalled by EndCommands for this list
+        g.dlfg_state = kM2bReadbackPending;
+    }
+    Barrier(g.dlfg_output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    return true;
+}
+
+static bool M3b1RecordEval(UINT64 frame, bool reset)
+{
+    NVSDK_NGX_D3D12_DLSSG_Eval_Params ep = {};
+    ep.pBackbuffer = g.tex12[SLOT_OUTPUT];
+    ep.pDepth = g.tex12[SLOT_DEPTH];
+    ep.pMVecs = g.tex12[SLOT_MV];
+    // This is the exact one-shot D3D12 resource already proven by M3B-1A to be
+    // shareable with the live Vulkan device. NVIDIA feature 11 writes it directly.
+    ep.pOutputInterpFrame = g.m3b1a_tex12;
+    NVSDK_NGX_DLSSG_Opt_Eval_Params op = {};
+    M2bBuildConstants(&op, reset);
+    DWORD code = 0;
+    const NVSDK_NGX_Result r = SafeEvaluateDLFG(&ep, &op, &code);
+    if (code != 0)
+    {
+        Log("[feed] M3B-1: evaluate reset=%d raised exception 0x%08X; command list will not execute",
+            reset ? 1 : 0, code);
+        M2bFail("DLSS-G evaluate raised an exception");
+        return false;
+    }
+    Log("[feed] M3B-1: evaluate reset=%d -> 0x%08X (%s), frame=%llu",
+        reset ? 1 : 0, r, NgxResultName(r), static_cast<unsigned long long>(frame));
+    if (NVSDK_NGX_FAILED(r)) M2bFail("NGX_D3D12_EVALUATE_DLSSG failed");
+    return true;
+}
+
+// Records a genuine one-shot feature-11 A/B sequence after the normal DLAA/NR
+// evaluation. The normal Feeder command list, D3D12 queue and NGX session are reused.
+static bool M3b1MaybeRecord(UINT64 frame, bool dlss_reset)
+{
+    if (g_cfg.dlfg_m3b1_present == 0 || g.dlfg_state == kM2bPassed ||
+        g.dlfg_state == kM2bFailed || g.dlfg_state == kM2bReadbackPending)
+        return true;
+    g.dlfg_owner = 2;
+    if (g_chicken_present)
+    {
+        M2bFail("DFC is present; genuine feature 11 is intentionally withheld");
+        return true;
+    }
+    if (frame <= 1 || g.width != 2560 || g.height != 1440 ||
+        g.color_fmt != DXGI_FORMAT_B8G8R8A8_UNORM ||
+        g.output_fmt != DXGI_FORMAT_B8G8R8A8_UNORM || g.tex12[SLOT_OUTPUT] == nullptr ||
+        g.tex12[SLOT_DEPTH] == nullptr || g.tex12[SLOT_MV] == nullptr ||
+        g.m3b1a_tex12 == nullptr || !g.m3b1a_vk_released || g.feature == nullptr || !g.ngx_inited)
+    {
+        M2bFail("required existing NGX/session and 2560x1440 shared B8/R32/R16G16 resources are unavailable");
+        return true;
+    }
+    if (!g_m2b_depth_valid)
+    {
+        if (g.dlfg_last_skip_frame == 0 || frame - g.dlfg_last_skip_frame >= 300)
+        {
+            g.dlfg_last_skip_frame = frame;
+            Log("[feed] M3B-1: waiting for valid non-flat depth from the existing 600-frame probe");
+        }
+        return true;
+    }
+
+    if (g.dlfg_feature == nullptr)
+    {
+        if (!M3b1CheckCapabilities())
+        {
+            M2bFail("FrameGeneration is unavailable, needs a driver, or lacks one generated frame");
+            return true;
+        }
+        if (!M3b1CreateReadbacks())
+        {
+            M2bFail("could not allocate generated-frame validation readbacks");
+            return true;
+        }
+        const NVSDK_NGX_Result ap = NVSDK_NGX_D3D12_AllocateParameters(&g.dlfg_params);
+        if (NVSDK_NGX_FAILED(ap) || g.dlfg_params == nullptr)
+        {
+            M2bFail("NVSDK_NGX_D3D12_AllocateParameters for DLSS-G failed");
+            return true;
+        }
+        NVSDK_NGX_DLSSG_Create_Params cp = {};
+        cp.Width = cp.RenderWidth = g.width;
+        cp.Height = cp.RenderHeight = g.height;
+        cp.NativeBackbufferFormat = static_cast<unsigned>(DXGI_FORMAT_B8G8R8A8_UNORM);
+        cp.DynamicResolutionScaling = false;
+        DWORD code = 0;
+        const NVSDK_NGX_Result cr = SafeCreateDLFG(&cp, &code);
+        if (code != 0)
+        {
+            Log("[feed] M3B-1: NGX_D3D12_CREATE_DLSSG raised exception 0x%08X", code);
+            g.dlfg_feature = nullptr;
+            M2bFail("NGX_D3D12_CREATE_DLSSG raised an exception");
+            return false;
+        }
+        Log("[feed] M3B-1: NGX_D3D12_CREATE_DLSSG -> 0x%08X (%s), feature=%p (existing D3D12 NGX session)",
+            cr, NgxResultName(cr), static_cast<void *>(g.dlfg_feature));
+        if (NVSDK_NGX_FAILED(cr) || g.dlfg_feature == nullptr)
+        {
+            M2bFail("NGX_D3D12_CREATE_DLSSG failed");
+            return true;
+        }
+        Log("[feed] M3B-1: armed after frame %llu; MV source=pixel-space current-to-previous, "
+            "mean sampled magnitude=%.6f px; DLSS-G mvecScale=1/width,1/height=%.9f,%.9f",
+            static_cast<unsigned long long>(frame), g_mv_probe_mean_px,
+            1.0f / static_cast<float>(g.width), 1.0f / static_cast<float>(g.height));
+    }
+
+    if (g.dlfg_state == kM2bIdle || dlss_reset)
+    {
+        if (g.dlfg_state == kM2bHistory && dlss_reset)
+            Log("[feed] M3B-1: Feeder reset interrupted history; re-arming on frame %llu",
+                static_cast<unsigned long long>(frame));
+        M2bCopyTextureToReadback(g.tex12[SLOT_OUTPUT], g.dlfg_prev_readback,
+                                 D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        Barrier(g.m3b1a_tex12, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        if (!M3b1RecordEval(frame, true)) return false;
+        Barrier(g.m3b1a_tex12, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+        Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        if (g.dlfg_state != kM2bFailed)
+        {
+            g.dlfg_state = kM2bHistory;
+            g.dlfg_history_frame = frame;
+            Log("[feed] M3B-1: real frame A accepted as temporal history, sourceFrame=%llu",
+                static_cast<unsigned long long>(frame));
+        }
+        return true;
+    }
+
+    if (frame != g.dlfg_history_frame + 1)
+    {
+        M2bFail("real frames A and B were not sequential");
+        return true;
+    }
+    M2bCopyTextureToReadback(g.tex12[SLOT_OUTPUT], g.dlfg_curr_readback,
+                             D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Barrier(g.m3b1a_tex12, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    if (!M3b1RecordEval(frame, false)) return false;
+    if (g.dlfg_state != kM2bFailed)
+    {
+        M2bCopyTextureToReadback(g.m3b1a_tex12, g.dlfg_output_readback,
+                                 D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        g.dlfg_readback_fence = g.fence_value + 1;
+        g.m3b1_ready_value = frame;
+        g.m3b1a_source_frame = frame;
+        g.m3b1a_copy_queued = true; // immutable from this point through teardown
+        g.dlfg_state = kM2bReadbackPending;
+        Log("[feed] M3B-1: generated output queued for validation; frame A=%llu frame B=%llu readyValue=%llu",
+            static_cast<unsigned long long>(g.dlfg_history_frame),
+            static_cast<unsigned long long>(frame), static_cast<unsigned long long>(frame));
+    }
+    Barrier(g.m3b1a_tex12, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    return true;
+}
+
+static void M2cFail(const char *why)
+{
+    // The M2C decision may fail before its own handle exists. Claim its log/result
+    // ownership first so an early DFC-ARMED finding can never be misreported as M2B.
+    g.dlfg_owner = 1;
+    M2bFail(why);
+}
+
+static void M2cLogBuildState(const char *checkpoint)
+{
+    if (g_cfg.dlfg_m2c_prearm_create == 0 || !g.vk.ok || !g_chicken_present) return;
+    if (!g.m2c_dfc_detected)
+    {
+        g.m2c_dfc_detected = true;
+        Log("[feed] M2C: DFC detected");
+        Log("[feed] M2C: DFC present");
+    }
+    ChickenPoll();
+    // These are bounded feature-build checkpoints, not the former per-frame poll log.
+    Log("[feed] M2C: %s = %ld (%s)", checkpoint, g_chicken_state, DfcStateName(g_chicken_state));
+}
+
+// M2C-A deliberately creates feature 11 in the existing feature-build list, before
+// feature-1/DLAA Create can give DFC the opportunity to reach ARMED. It never publishes
+// DFC.Feeder.* (those are feature-1-only markers), replaces no entry point, and does not
+// evaluate until a later normal DLAA/DFC evaluation has succeeded in ARMED.
+static bool M2cMaybePrearmCreate()
+{
+    if (g_cfg.dlfg_m2c_prearm_create == 0 || !g.vk.ok || !g_chicken_present ||
+        g.m2c_evaluation_attempted || g.m2c_state == kM2cPrearmed ||
+        g.m2c_state == kM2cWaitingArmed || g.m2c_state == kM2cPassed || g.m2c_state == kM2cFailed)
+        return true;
+
+    M2cLogBuildState("state before DLSS-G create");
+    if (!g_chicken_loaded || !g_chicken_abi || g_chicken_state != DFC_STATE_CLAIMING)
+    {
+        if (g_chicken_state == DFC_STATE_ARMED)
+            M2cFail("DFC was already ARMED at BuildFeature entry/before feature-1 Create; no safe pre-arm window exists without a DFC-side change");
+        return true; // wait for the ABI and its explicit CLAIMING window; never guess.
+    }
+    if (g.width != 2560 || g.height != 1440 || g.color_fmt != DXGI_FORMAT_B8G8R8A8_UNORM ||
+        g.output_fmt != DXGI_FORMAT_B8G8R8A8_UNORM || g.tex12[SLOT_OUTPUT] == nullptr ||
+        g.tex12[SLOT_DEPTH] == nullptr || g.tex12[SLOT_MV] == nullptr || !g.ngx_inited)
+    {
+        M2cFail("pre-arm creation lacks the validated existing D3D12 NGX/session resources");
+        return true;
+    }
+
+    g.dlfg_owner = 1;
+    g.m2c_prearm_dfc_state = g_chicken_state;
+    Log("[feed] M2C: DFC state before DLSS-G create = %s", DfcStateName(g_chicken_state));
+    Log("[feed] M2C: attempting pre-arm DLSS-G creation");
+    if (!M2bCheckCapabilities()) { M2cFail("pre-arm FrameGeneration capability check failed"); return true; }
+    if (!M2bCreateResources()) { M2cFail("could not allocate private pre-arm output/readback resources"); return true; }
+    const NVSDK_NGX_Result ap = NVSDK_NGX_D3D12_AllocateParameters(&g.dlfg_params);
+    if (NVSDK_NGX_FAILED(ap) || g.dlfg_params == nullptr)
+    {
+        M2cFail("NVSDK_NGX_D3D12_AllocateParameters for pre-arm DLSS-G failed");
+        return true;
+    }
+    NVSDK_NGX_DLSSG_Create_Params cp = {};
+    cp.Width = cp.RenderWidth = g.width;
+    cp.Height = cp.RenderHeight = g.height;
+    cp.NativeBackbufferFormat = static_cast<unsigned>(DXGI_FORMAT_B8G8R8A8_UNORM);
+    cp.DynamicResolutionScaling = false;
+    DWORD ccode = 0;
+    const NVSDK_NGX_Result cr = SafeCreateDLFG(&cp, &ccode);
+    if (ccode != 0)
+    {
+        Log("[feed] M2C: pre-arm NGX_D3D12_CREATE_DLSSG -> exception 0x%08X", ccode);
+        g.dlfg_feature = nullptr;
+        M2cFail("pre-arm NGX_D3D12_CREATE_DLSSG raised an exception");
+        return false; // caller must discard this command list.
+    }
+    Log("[feed] M2C: pre-arm NGX_D3D12_CREATE_DLSSG -> 0x%08X (%s), feature=%p",
+        cr, NgxResultName(cr), (void *)g.dlfg_feature);
+    if (NVSDK_NGX_FAILED(cr) || g.dlfg_feature == nullptr)
+    {
+        M2cFail("pre-arm NGX_D3D12_CREATE_DLSSG failed");
+        return true;
+    }
+    g.m2c_state = kM2cPrearmed;
+    Log("[feed] M2C: pre-arm create retained; no evaluation occurs until DFC is ARMED. "
+        "MV source = pixel-space current-to-previous; DLSS-G mvecScale = 1/width, 1/height = %.9f,%.9f",
+        1.0f / static_cast<float>(g.width), 1.0f / static_cast<float>(g.height));
+    return true;
+}
+
+// Called only after the normal SafeEvaluateDLSS call returned for this frame. That gives
+// the probe a real post-DLAA/DFC SLOT_OUTPUT and proves the ordinary DFC path stayed live.
+static bool M2cMaybeRecord(UINT64 frame, bool dlss_reset)
+{
+    if (g_cfg.dlfg_m2c_prearm_create == 0 || !g_chicken_present || g.dlfg_owner == 0 ||
+        g.m2c_state == kM2cFailed || g.m2c_state == kM2cPassed || g.dlfg_state == kM2bReadbackPending)
+        return true;
+
+    ChickenPoll();
+    if (g_chicken_state != DFC_STATE_ARMED) return true;
+    if (!g.m2c_armed_seen)
+    {
+        g.m2c_armed_seen = true;
+        Log("[feed] M2C: DFC transitioned to ARMED");
+        Log("[feed] M2C: DFC ARMED and normal feature-1 evaluation succeeded");
+    }
+    if (g.dlfg_feature == nullptr) { M2bFail("pre-arm feature was invalid after DFC armed"); return true; }
+    if (!g_m2b_depth_valid)
+    {
+        if (g.dlfg_last_skip_frame == 0 || frame - g.dlfg_last_skip_frame >= 300)
+        {
+            g.dlfg_last_skip_frame = frame;
+            Log("[feed] M2C: waiting for valid real depth before coexistence evaluation");
+        }
+        return true;
+    }
+
+    if (g.dlfg_state == kM2bIdle || dlss_reset)
+    {
+        g.m2c_state = kM2cEvaluating;
+        Log("[feed] M2C: running FG evaluation with DFC active");
+        M2bCopyTextureToReadback(g.tex12[SLOT_OUTPUT], g.dlfg_prev_readback, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        Barrier(g.dlfg_output, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        if (!M2bRecordEval(frame, true, "M2C")) return false;
+        Barrier(g.dlfg_output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+        Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        if (g.dlfg_state != kM2bFailed)
+        {
+            g.dlfg_state = kM2bHistory;
+            g.dlfg_history_frame = frame;
+            g.m2c_state = kM2cWaitingArmed;
+        }
+        return true;
+    }
+
+    g.m2c_evaluation_attempted = true;
+    M2bCopyTextureToReadback(g.tex12[SLOT_OUTPUT], g.dlfg_curr_readback, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    Barrier(g.dlfg_output, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    if (!M2bRecordEval(frame, false, "M2C")) return false;
+    if (g.dlfg_state != kM2bFailed)
+    {
+        M2bCopyTextureToReadback(g.dlfg_output, g.dlfg_output_readback, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        g.dlfg_readback_fence = g.fence_value + 1;
+        g.dlfg_state = kM2bReadbackPending;
+        Log("[feed] M2C: readback -> queued on existing D3D12 fence");
+    }
+    Barrier(g.dlfg_output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+    Barrier(g.tex12[SLOT_OUTPUT], D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    return true;
+}
+
+static uint64_t M2bHash(const uint8_t *p, UINT row_pitch)
+{
+    uint64_t h = 1469598103934665603ull;
+    for (UINT y = 0; y < g.height; ++y)
+        for (UINT x = 0; x < g.width * 4u; ++x) { h ^= p[y * row_pitch + x]; h *= 1099511628211ull; }
+    return h;
+}
+
+struct M2bStats { uint64_t hash, nonzero; double b, g, r; uint8_t minv[3], maxv[3]; };
+
+static M2bStats M2bStatsFor(const uint8_t *p, UINT row_pitch)
+{
+    M2bStats s = {}; s.minv[0] = s.minv[1] = s.minv[2] = 255;
+    const uint64_t pixels = static_cast<uint64_t>(g.width) * g.height;
+    for (UINT y = 0; y < g.height; ++y)
+        for (UINT x = 0; x < g.width; ++x)
+        {
+            const uint8_t *q = p + y * row_pitch + x * 4;
+            if (q[0] || q[1] || q[2]) ++s.nonzero;
+            for (UINT c = 0; c < 3; ++c) { s.minv[c] = (std::min)(s.minv[c], q[c]); s.maxv[c] = (std::max)(s.maxv[c], q[c]); }
+            s.b += q[0]; s.g += q[1]; s.r += q[2];
+        }
+    s.hash = M2bHash(p, row_pitch);
+    s.b /= pixels; s.g /= pixels; s.r /= pixels;
+    return s;
+}
+
+static bool M2bWriteBmp(const uint8_t *p, UINT row_pitch, char path[MAX_PATH])
+{
+    GetModuleFileNameA(g_self, path, MAX_PATH);
+    char *slash = strrchr(path, '\\');
+    if (slash == nullptr) return false;
+    strcpy_s(slash + 1, MAX_PATH - (slash + 1 - path), "dlfg-m2b-generated.bmp");
+    FILE *f = nullptr;
+    if (fopen_s(&f, path, "wb") != 0 || f == nullptr) return false;
+    const uint32_t pixels_bytes = g.width * g.height * 4u, file_bytes = 54u + pixels_bytes;
+    uint8_t head[54] = {};
+    head[0] = 'B'; head[1] = 'M';
+    const auto put32 = [&head](int at, uint32_t v) { head[at] = static_cast<uint8_t>(v); head[at + 1] = static_cast<uint8_t>(v >> 8); head[at + 2] = static_cast<uint8_t>(v >> 16); head[at + 3] = static_cast<uint8_t>(v >> 24); };
+    put32(2, file_bytes); put32(10, 54); put32(14, 40); put32(18, g.width); put32(22, g.height);
+    head[26] = 1; head[28] = 32; put32(34, pixels_bytes);
+    bool ok = fwrite(head, 1, sizeof(head), f) == sizeof(head);
+    for (UINT y = g.height; ok && y-- > 0; ) ok = fwrite(p + y * row_pitch, 1, g.width * 4u, f) == g.width * 4u;
+    fclose(f);
+    return ok;
+}
+
+static void M2bPollReadback()
+{
+    if (g.dlfg_state != kM2bReadbackPending || g.fence12 == nullptr ||
+        g.fence12->GetCompletedValue() < g.dlfg_readback_fence) return;
+    void *prev = nullptr, *curr = nullptr, *out = nullptr;
+    const D3D12_RANGE read = { 0, g.dlfg_readback_bytes };
+    if (FAILED(g.dlfg_prev_readback->Map(0, &read, &prev)) || prev == nullptr ||
+        FAILED(g.dlfg_curr_readback->Map(0, &read, &curr)) || curr == nullptr ||
+        FAILED(g.dlfg_output_readback->Map(0, &read, &out)) || out == nullptr)
+    {
+        if (prev) g.dlfg_prev_readback->Unmap(0, nullptr);
+        if (curr) g.dlfg_curr_readback->Unmap(0, nullptr);
+        if (out)  g.dlfg_output_readback->Unmap(0, nullptr);
+        M2bFail("could not map completed CPU readback");
+        return;
+    }
+    const UINT pitch = g.dlfg_footprint.Footprint.RowPitch;
+    const uint8_t *a = static_cast<const uint8_t *>(prev), *b = static_cast<const uint8_t *>(curr), *o = static_cast<const uint8_t *>(out);
+    const M2bStats sa = M2bStatsFor(a, pitch), sb = M2bStatsFor(b, pitch), so = M2bStatsFor(o, pitch);
+    uint64_t diff_a = 0, diff_b = 0, diff_ab = 0;
+    for (UINT y = 0; y < g.height; ++y)
+        for (UINT x = 0; x < g.width; ++x)
+        {
+            const uint8_t *pa = a + y * pitch + x * 4, *pb = b + y * pitch + x * 4, *po = o + y * pitch + x * 4;
+            if (memcmp(po, pa, 3) != 0) ++diff_a;
+            if (memcmp(po, pb, 3) != 0) ++diff_b;
+            if (memcmp(pa, pb, 3) != 0) ++diff_ab;
+        }
+    char bmp[MAX_PATH] = {};
+    const bool bmp_ok = M2bWriteBmp(o, pitch, bmp);
+    const D3D12_RANGE none = { 0, 0 };
+    g.dlfg_prev_readback->Unmap(0, &none); g.dlfg_curr_readback->Unmap(0, &none); g.dlfg_output_readback->Unmap(0, &none);
+    const double pixels = static_cast<double>(g.width) * g.height;
+    const char *tag = DlfgOwnerTag();
+    Log("[feed] %s: readback completed; output checksum %016llx nonzero %llu/%llu avg RGB %.2f/%.2f/%.2f min RGB %u/%u/%u max RGB %u/%u/%u",
+        tag,
+        static_cast<unsigned long long>(so.hash), static_cast<unsigned long long>(so.nonzero),
+        static_cast<unsigned long long>(static_cast<uint64_t>(pixels)), so.r, so.g, so.b,
+        so.minv[2], so.minv[1], so.minv[0], so.maxv[2], so.maxv[1], so.maxv[0]);
+    Log("[feed] %s: Frame A checksum %016llx; Frame B checksum %016llx; generated differs from A: %llu (%.3f%%), B: %llu (%.3f%%)",
+        tag,
+        static_cast<unsigned long long>(sa.hash), static_cast<unsigned long long>(sb.hash),
+        static_cast<unsigned long long>(diff_a), 100.0 * diff_a / pixels,
+        static_cast<unsigned long long>(diff_b), 100.0 * diff_b / pixels);
+    if (!bmp_ok) { M2bFail("could not write dlfg-m2b-generated.bmp beside the experimental Feeder"); return; }
+    const uint64_t material = (static_cast<uint64_t>(g.width) * g.height) / 10000u; // 0.01%
+    const bool insufficient = g.dlfg_owner == 2
+        ? so.nonzero == 0 || diff_a < material || diff_b < material
+        : so.nonzero == 0 || diff_a == 0 || diff_b == 0;
+    if (insufficient)
+    {

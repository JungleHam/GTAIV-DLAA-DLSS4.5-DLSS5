+static std::string M3aWaitSemaphores(const VkPresentInfoKHR& info)
+{
+    if (info.waitSemaphoreCount == 0 || info.pWaitSemaphores == nullptr) return "none";
+    std::string result;
+    for (uint32_t i = 0; i < info.waitSemaphoreCount; ++i)

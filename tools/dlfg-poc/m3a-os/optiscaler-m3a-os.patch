+    const VkSemaphore waits[] = { gameReady, _m3b.acquireReady, frame.producerTimeline };
+    const VkSemaphore signals[] = { _m3b.duplicateReady, _m3b.originalReady };
+    if (_m3aQueueSubmit2 != nullptr)

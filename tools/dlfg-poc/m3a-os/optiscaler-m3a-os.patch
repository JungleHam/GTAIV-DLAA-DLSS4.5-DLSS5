+            waitInfos[i].sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO;
+            waitInfos[i].semaphore = waits[i];
+            waitInfos[i].value = i == 2 ? frame.producerReadyValue : 0;
+            waitInfos[i].stageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT;
+        }
+        VkSemaphoreSubmitInfo signalInfos[2] {};
+        for (uint32_t i = 0; i < 2; ++i)
+        {
+            signalInfos[i].sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO;
+            signalInfos[i].semaphore = signals[i];
+            signalInfos[i].stageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+        }
+        VkCommandBufferSubmitInfo commandInfo { VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO };
+        commandInfo.commandBuffer = _m3b.commandBuffer;
+        VkSubmitInfo2 submit { VK_STRUCTURE_TYPE_SUBMIT_INFO_2 };
+        submit.waitSemaphoreInfoCount = 3;
+        submit.pWaitSemaphoreInfos = waitInfos;
+        submit.commandBufferInfoCount = 1;
+        submit.pCommandBufferInfos = &commandInfo;
+        submit.signalSemaphoreInfoCount = 2;

+static void M3bReleaseAcquiredImage(VkQueue queue, VkSwapchainKHR swapchain, uint32_t imageIndex)
+{
+    // An acquired image must be returned even on an unexpected local failure. It has
+    // not been modified in these paths, and this uses no wait semaphore.
+    VkPresentInfoKHR release { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+    release.swapchainCount = 1;
+    release.pSwapchains = &swapchain;
+    release.pImageIndices = &imageIndex;
+    const VkResult releaseResult = o_QueuePresentKHR(queue, &release);
+    LOG_WARN("M3B-0: released acquired image {} after local failure -> {}", imageIndex, (int) releaseResult);
+}

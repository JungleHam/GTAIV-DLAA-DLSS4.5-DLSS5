+static bool M3b1aResolveFeederAbi()
+{
+    if (_m3b1aQuery != nullptr && _m3b1aConsume != nullptr) return true;
+    HMODULE feeder = GetModuleHandleW(L"dlss5-feed.addon64");
+    if (feeder == nullptr) return false;
+    _m3b1aQuery = reinterpret_cast<PFN_DLSS5_QueryM3B1AExternalFrame>(
+        GetProcAddress(feeder, "DLSS5_QueryM3B1AExternalFrame"));
+    _m3b1aConsume = reinterpret_cast<PFN_DLSS5_ConsumeM3B1AExternalFrame>(
+        GetProcAddress(feeder, "DLSS5_ConsumeM3B1AExternalFrame"));
+    _m3b1IsGenerated = reinterpret_cast<PFN_DLSS5_IsM3B1GeneratedFrame>(
+        GetProcAddress(feeder, "DLSS5_IsM3B1GeneratedFrame"));
+    if (_m3b1aQuery == nullptr || _m3b1aConsume == nullptr)
+    {
+        _m3b1aQuery = nullptr;
+        _m3b1aConsume = nullptr;
+        _m3b1IsGenerated = nullptr;
+        return false;
+    }
+    LOG_INFO("M3B-1A: resolved Feeder external-frame ABI; genuine M3B-1 provenance={}",
+             _m3b1IsGenerated != nullptr);
+    return true;
+}

+static void M3bDestroyResourcesLocked()
+{
+    if (_m3b.device != VK_NULL_HANDLE)
+    {
+        if (_m3b.commandPool != VK_NULL_HANDLE)
+            vkDestroyCommandPool(_m3b.device, _m3b.commandPool, nullptr);
+        if (_m3b.acquireReady != VK_NULL_HANDLE)
+            vkDestroySemaphore(_m3b.device, _m3b.acquireReady, nullptr);
+        if (_m3b.duplicateReady != VK_NULL_HANDLE)
+            vkDestroySemaphore(_m3b.device, _m3b.duplicateReady, nullptr);
+        if (_m3b.originalReady != VK_NULL_HANDLE)
+            vkDestroySemaphore(_m3b.device, _m3b.originalReady, nullptr);
+    }
+    _m3b = {};
+}

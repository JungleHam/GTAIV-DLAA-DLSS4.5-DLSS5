+static VkResult M3b1aSubmitExternalCopyLocked(VkQueue queue, uint32_t extraIndex, VkSemaphore gameReady,
+                                               const Dlss5M3b1aPublishedFrame& frame)
+{
+    VkResult result = vkResetCommandBuffer(_m3b.commandBuffer, 0);
+    if (result != VK_SUCCESS) return result;
+    VkCommandBufferBeginInfo beginInfo { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    result = vkBeginCommandBuffer(_m3b.commandBuffer, &beginInfo);
+    if (result != VK_SUCCESS) return result;

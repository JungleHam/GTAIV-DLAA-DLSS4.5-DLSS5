+// Returns true only after this function has consumed the game's wait semaphore and
+// therefore forwarded the original present with the replacement semaphore.
+static bool M3b1aTryExternalPresent(VkQueue queue, VkPresentInfoKHR& gamePresent, bool queueFamilyKnown,
+                                    uint32_t queueFamily, VkResult* originalResult)
+{
+    if (!M3b1aEnabled() || originalResult == nullptr || !queueFamilyKnown || _m3b1aAttempted) return false;
+    if (gamePresent.swapchainCount != 1 || gamePresent.pSwapchains == nullptr || gamePresent.pImageIndices == nullptr ||
+        gamePresent.waitSemaphoreCount != 1 || gamePresent.pWaitSemaphores == nullptr || !M3b1aResolveFeederAbi())
+        return false;
+
+    Dlss5M3b1aPublishedFrame frame {};
+    if (!_m3b1aQuery(&frame) || frame.serial == _m3b1aLastSerial) return false;
+    const bool genuineM3b1 = _m3b1IsGenerated != nullptr && _m3b1IsGenerated(frame.serial) != FALSE;
+
+    std::lock_guard lock(_m3bMutex);
+    _m3b1aAttempted = true;
+    _m3b1aLastSerial = frame.serial;
+    const VkSwapchainKHR swapchain = gamePresent.pSwapchains[0];
+    const bool transferSupported = (_m3b.usage & VK_IMAGE_USAGE_TRANSFER_DST_BIT) != 0;
+    const bool valid = frame.abiVersion == 1 && frame.structSize == sizeof(frame) && frame.ready != 0 &&
+                       frame.device == _m3b.device && frame.image != VK_NULL_HANDLE &&
+                       frame.producerTimeline != VK_NULL_HANDLE && frame.producerReadyValue != 0 &&
+                       frame.format == _m3b.format && frame.width == _m3b.extent.width &&
+                       frame.height == _m3b.extent.height && frame.externalRestingLayout == VK_IMAGE_LAYOUT_GENERAL &&
+                       _m3b.swapchain == swapchain && _m3b.imageCount >= 3 && transferSupported &&
+                       _m3aAcquireNextImageKHR != nullptr && _m3aQueueSubmit != nullptr;
+    LOG_INFO("M3B-1A: Feeder serial={} sourceFrame={} image={:X} producerTimeline={:X} readyValue={} "
+             "source={} {}x{} swapchain={} {}x{} family={}",
+             frame.serial, frame.sourceFrame, (UINT64) frame.image, (UINT64) frame.producerTimeline,
+             frame.producerReadyValue, (int) frame.format, frame.width, frame.height,
+             (int) _m3b.format, _m3b.extent.width, _m3b.extent.height, queueFamily);
+    if (genuineM3b1)
+        LOG_INFO("M3B-1: Feeder generation serial={} sourceFrame={} generated VkImage={:X} "
+                 "source/generated format={} swapchain format={} extent={}x{} readyValue={}",
+                 frame.serial, frame.sourceFrame, (UINT64) frame.image, (int) frame.format,
+                 (int) _m3b.format, frame.width, frame.height, frame.producerReadyValue);
+    if (!valid)
+    {
+        LOG_ERROR("M3B-1A: publication/swapchain prerequisites failed; one-shot withheld");
+        return false;
+    }
+    if (!M3bCreateResourcesLocked(queueFamily))
+    {
+        LOG_ERROR("M3B-1A: same-family command resources unavailable");
+        return false;
+    }
+
+    uint32_t extraIndex = UINT32_MAX;
+    const VkResult acquireResult = _m3aAcquireNextImageKHR(_m3b.device, swapchain, 0, _m3b.acquireReady,
+                                                            VK_NULL_HANDLE, &extraIndex);
+    if (genuineM3b1)
+        LOG_INFO("M3B-1: consumer acquired image={} acquire result={}", extraIndex, (int) acquireResult);
+    else
+        LOG_INFO("M3B-1A consumer acquired image={} acquire result={}", extraIndex, (int) acquireResult);
+    if (acquireResult != VK_SUCCESS) return false;
+    if (extraIndex >= _m3b.images.size())
+    {
+        LOG_ERROR("M3B-1A: acquired invalid swapchain index={}", extraIndex);
+        return false;
+    }
+
+    const VkResult submitResult = M3b1aSubmitExternalCopyLocked(
+        queue, extraIndex, gamePresent.pWaitSemaphores[0], frame);
+    if (genuineM3b1) LOG_INFO("M3B-1: submit result={}", (int) submitResult);
+    else LOG_INFO("M3B-1A submit result={}", (int) submitResult);
+    if (submitResult != VK_SUCCESS)
+    {
+        M3bReleaseAcquiredImage(queue, swapchain, extraIndex);
+        return false;
+    }
+
+    VkPresentInfoKHR externalPresent { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+    externalPresent.waitSemaphoreCount = 1;
+    externalPresent.pWaitSemaphores = &_m3b.duplicateReady;
+    externalPresent.swapchainCount = 1;
+    externalPresent.pSwapchains = &swapchain;
+    externalPresent.pImageIndices = &extraIndex;
+    const VkResult externalResult = o_QueuePresentKHR(queue, &externalPresent);
+    if (genuineM3b1) LOG_INFO("M3B-1: generated present result={}", (int) externalResult);
+    else LOG_INFO("M3B-1A external-image present result={}", (int) externalResult);
+
+    gamePresent.pWaitSemaphores = &_m3b.originalReady;
+    *originalResult = o_QueuePresentKHR(queue, &gamePresent);
+    if (genuineM3b1) LOG_INFO("M3B-1: original present result={}", (int) *originalResult);
+    else LOG_INFO("M3B-1A original present result={}", (int) *originalResult);
+    if (externalResult == VK_SUCCESS) _m3b1aConsume(frame.serial);
+    if (externalResult == VK_SUCCESS && *originalResult == VK_SUCCESS)
+    {
+        if (genuineM3b1)
+            LOG_INFO("MILESTONE M3B-1 PASSED: genuine NVIDIA DLSS-G generated frame presented to GTA IV live Vulkan swapchain");
+        else
+            LOG_INFO("MILESTONE M3B-1A PASSED");
+    }
+    else
+        LOG_ERROR("M3B-1A: inserted/original present did not both succeed");
+    return true;
+}

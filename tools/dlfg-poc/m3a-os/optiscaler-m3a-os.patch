+static void M3bCaptureSwapchain(VkDevice device, const VkSwapchainCreateInfoKHR* createInfo, VkSwapchainKHR swapchain)
+{
+    if ((!M3bEnabled() && !M3b1aEnabled()) || createInfo == nullptr || swapchain == VK_NULL_HANDLE) return;
+    std::lock_guard lock(_m3bMutex);
+    if (M3b1aEnabled() && _m3b1aAttempted && _m3b.device != VK_NULL_HANDLE)
+        vkDeviceWaitIdle(_m3b.device);
+    M3bDestroyResourcesLocked();
+    M3aResolveDeviceFunctions(device);
+    if (_m3aGetSwapchainImagesKHR == nullptr)
+    {
+        LOG_ERROR("M3B-0: skipped: vkGetSwapchainImagesKHR pointer unavailable");
+        return;
+    }
+    uint32_t count = 0;
+    const VkResult countResult = _m3aGetSwapchainImagesKHR(device, swapchain, &count, nullptr);
+    if (countResult != VK_SUCCESS || count == 0)
+    {
+        LOG_ERROR("M3B-0: skipped: vkGetSwapchainImagesKHR count -> {} count={}", (int) countResult, count);
+        return;
+    }
+    std::vector<VkImage> images(count);
+    const VkResult imagesResult = _m3aGetSwapchainImagesKHR(device, swapchain, &count, images.data());
+    if (imagesResult != VK_SUCCESS || count != images.size())
+    {
+        LOG_ERROR("M3B-0: skipped: vkGetSwapchainImagesKHR images -> {} count={}", (int) imagesResult, count);
+        return;
+    }
+    _m3b.device = device;
+    _m3b.swapchain = swapchain;
+    _m3b.extent = createInfo->imageExtent;
+    _m3b.format = createInfo->imageFormat;
+    _m3b.usage = createInfo->imageUsage;
+    _m3b.imageCount = count;
+    _m3b.images = std::move(images);
+    _m3bNormalPresents = 0;
+    _m3bAttempted = false;
+    _m3b1aAttempted = false;
+    LOG_INFO("M3B: captured swapchain sc={:X} images={} usage=0x{:X}; duplicate={} external={}",
+             (UINT64) swapchain, count, (uint32_t) _m3b.usage, M3bEnabled(), M3b1aEnabled());
+}
+
+static bool M3bCreateResourcesLocked(uint32_t queueFamily)
+{
+    if (_m3b.commandBuffer != VK_NULL_HANDLE) return _m3b.queueFamily == queueFamily;
+    VkCommandPoolCreateInfo poolInfo { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    poolInfo.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT | VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    poolInfo.queueFamilyIndex = queueFamily;
+    VkResult result = vkCreateCommandPool(_m3b.device, &poolInfo, nullptr, &_m3b.commandPool);
+    if (result != VK_SUCCESS) { LOG_ERROR("M3B-0: vkCreateCommandPool -> {}", (int) result); return false; }
+    VkCommandBufferAllocateInfo allocInfo { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    allocInfo.commandPool = _m3b.commandPool;
+    allocInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    allocInfo.commandBufferCount = 1;
+    result = vkAllocateCommandBuffers(_m3b.device, &allocInfo, &_m3b.commandBuffer);
+    if (result != VK_SUCCESS) { LOG_ERROR("M3B-0: vkAllocateCommandBuffers -> {}", (int) result); M3bDestroyResourcesLocked(); return false; }
+    VkSemaphoreCreateInfo semaphoreInfo { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+    result = vkCreateSemaphore(_m3b.device, &semaphoreInfo, nullptr, &_m3b.acquireReady);
+    if (result == VK_SUCCESS) result = vkCreateSemaphore(_m3b.device, &semaphoreInfo, nullptr, &_m3b.duplicateReady);
+    if (result == VK_SUCCESS) result = vkCreateSemaphore(_m3b.device, &semaphoreInfo, nullptr, &_m3b.originalReady);
+    if (result != VK_SUCCESS) { LOG_ERROR("M3B-0: vkCreateSemaphore -> {}", (int) result); M3bDestroyResourcesLocked(); return false; }
+    _m3b.queueFamily = queueFamily;
+    return true;
+}
+
+static VkResult M3bSubmitCopyLocked(VkQueue queue, uint32_t sourceIndex, uint32_t extraIndex, VkSemaphore gameReady)
+{
+    const VkResult resetResult = vkResetCommandBuffer(_m3b.commandBuffer, 0);
+    if (resetResult != VK_SUCCESS) return resetResult;
+    VkCommandBufferBeginInfo beginInfo { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    VkResult result = vkBeginCommandBuffer(_m3b.commandBuffer, &beginInfo);
+    if (result != VK_SUCCESS) return result;
+    VkImageMemoryBarrier toTransfer[2] {};
+    for (auto& barrier : toTransfer)
+    {
+        barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        barrier.oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+        barrier.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        barrier.subresourceRange.levelCount = 1;
+        barrier.subresourceRange.layerCount = 1;
+        barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    }
+    toTransfer[0].image = _m3b.images[sourceIndex];
+    toTransfer[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    toTransfer[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    toTransfer[1].image = _m3b.images[extraIndex];
+    toTransfer[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    toTransfer[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    vkCmdPipelineBarrier(_m3b.commandBuffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                         0, nullptr, 0, nullptr, 2, toTransfer);
+    VkImageCopy copy {};
+    copy.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    copy.srcSubresource.layerCount = 1;

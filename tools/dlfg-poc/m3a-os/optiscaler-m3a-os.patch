+// Returns true only when the original game present has been forwarded with originalReady.
+static bool M3bTryDuplicatePresent(VkQueue queue, VkPresentInfoKHR& gamePresent, bool queueFamilyKnown,
+                                   uint32_t queueFamily, VkResult* originalResult)
+{
+    if (!M3bEnabled() || originalResult == nullptr || !queueFamilyKnown) return false;
+    if (gamePresent.swapchainCount != 1 || gamePresent.pSwapchains == nullptr || gamePresent.pImageIndices == nullptr ||
+        gamePresent.waitSemaphoreCount != 1 || gamePresent.pWaitSemaphores == nullptr)
+        return false;
+    if (_m3bNormalPresents.load() < 300) return false;
+
+    std::lock_guard lock(_m3bMutex);
+    if (_m3bAttempted) return false;
+    _m3bAttempted = true; // One acquire attempt per process/swapchain, including a non-blocking miss.
+    const VkSwapchainKHR swapchain = gamePresent.pSwapchains[0];
+    const uint32_t sourceIndex = gamePresent.pImageIndices[0];
+    const bool transferSupported = (_m3b.usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) != 0 &&
+                                   (_m3b.usage & VK_IMAGE_USAGE_TRANSFER_DST_BIT) != 0;
+    if (_m3b.device == VK_NULL_HANDLE || _m3b.swapchain != swapchain || _m3b.imageCount < 3 ||
+        sourceIndex >= _m3b.images.size() || !transferSupported || _m3aAcquireNextImageKHR == nullptr ||
+        _m3aQueueSubmit == nullptr)
+    {
+        LOG_ERROR("M3B-0: skipped: prerequisites failed sc={:X} source={} images={} transfer={} acquire={} submit={}",
+                  (UINT64) swapchain, sourceIndex, _m3b.imageCount, transferSupported,
+                  _m3aAcquireNextImageKHR != nullptr, _m3aQueueSubmit != nullptr);
+        return false;
+    }
+    if (!M3bCreateResourcesLocked(queueFamily))
+    {
+        LOG_ERROR("M3B-0: skipped: could not create same-family command resources family={}", queueFamily);
+        return false;
+    }
+    uint32_t extraIndex = UINT32_MAX;
+    const VkResult acquireResult = _m3aAcquireNextImageKHR(_m3b.device, swapchain, 0, _m3b.acquireReady,
+                                                            VK_NULL_HANDLE, &extraIndex);
+    LOG_INFO("M3B-0: source image index={} extra acquired image index={} acquire result={}",
+             sourceIndex, extraIndex, (int) acquireResult);
+    if (acquireResult != VK_SUCCESS)
+    {
+        LOG_WARN("M3B-0: no extra image available without waiting; duplicate present skipped");
+        return false;
+    }
+    if (extraIndex >= _m3b.images.size())
+    {
+        LOG_ERROR("M3B-0: skipped: invalid extra acquired image index={}", extraIndex);
+        return false;
+    }
+    if (extraIndex == sourceIndex)
+    {
+        LOG_ERROR("M3B-0: skipped: acquired image unexpectedly equals source index={}", extraIndex);
+        M3bReleaseAcquiredImage(queue, swapchain, extraIndex);
+        return false;
+    }
+    const VkResult submitResult = M3bSubmitCopyLocked(queue, sourceIndex, extraIndex, gamePresent.pWaitSemaphores[0]);
+    LOG_INFO("M3B-0: submit result={}", (int) submitResult);
+    if (submitResult != VK_SUCCESS)
+    {
+        M3bReleaseAcquiredImage(queue, swapchain, extraIndex);
+        return false; // The unsuccessful submit did not consume the game's semaphore; caller forwards unchanged.
+    }
+
+    VkPresentInfoKHR duplicatePresent { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+    duplicatePresent.waitSemaphoreCount = 1;
+    duplicatePresent.pWaitSemaphores = &_m3b.duplicateReady;
+    duplicatePresent.swapchainCount = 1;
+    duplicatePresent.pSwapchains = &swapchain;
+    duplicatePresent.pImageIndices = &extraIndex;
+    const VkResult duplicateResult = o_QueuePresentKHR(queue, &duplicatePresent);
+    LOG_INFO("M3B-0: duplicate present result={}", (int) duplicateResult);
+
+    // The game's render-finished semaphore was consumed by the submit; it must not be waited twice.
+    gamePresent.pWaitSemaphores = &_m3b.originalReady;
+    *originalResult = o_QueuePresentKHR(queue, &gamePresent);
+    LOG_INFO("M3B-0: original present result={}", (int) *originalResult);
+    if (duplicateResult == VK_SUCCESS && *originalResult == VK_SUCCESS)
+        LOG_INFO("MILESTONE M3B-0 PASSED");
+    else
+        LOG_ERROR("M3B-0: duplicate/original present did not both succeed");
+    return true;
+}

+
+static void M3aResolveDeviceFunctions(VkDevice device)
+{
+    if ((!M3aEnabled() && !M3bEnabled() && !M3b1aEnabled()) || device == VK_NULL_HANDLE) return;
+    const auto gdpa = o_vkGetDeviceProcAddr != nullptr ? o_vkGetDeviceProcAddr : vkGetDeviceProcAddr;
+    if (gdpa == nullptr) return;
+    _m3aAcquireNextImageKHR = (PFN_vkAcquireNextImageKHR) gdpa(device, "vkAcquireNextImageKHR");
+    _m3aGetSwapchainImagesKHR = (PFN_vkGetSwapchainImagesKHR) gdpa(device, "vkGetSwapchainImagesKHR");
+    _m3aQueueSubmit = (PFN_vkQueueSubmit) gdpa(device, "vkQueueSubmit");
+    _m3aQueueSubmit2 = (PFN_vkQueueSubmit2) gdpa(device, "vkQueueSubmit2");
+    LOG_INFO("M3A-OS: resolved Vulkan pointers AcquireNextImageKHR={:X} GetSwapchainImagesKHR={:X} "
+             "QueueSubmit={:X} QueueSubmit2={:X} (resolved only; none called by M3A-OS)",
+             (UINT64) _m3aAcquireNextImageKHR, (UINT64) _m3aGetSwapchainImagesKHR,
+             (UINT64) _m3aQueueSubmit, (UINT64) _m3aQueueSubmit2);
+}
+
+static std::string M3aQueueFamilyIndices(const VkSwapchainCreateInfoKHR* createInfo)
+{
+    if (createInfo == nullptr || createInfo->queueFamilyIndexCount == 0 || createInfo->pQueueFamilyIndices == nullptr)
+        return "none";
+    std::string result;
+    for (uint32_t i = 0; i < createInfo->queueFamilyIndexCount; ++i)
+    {
+        if (!result.empty()) result += ",";
+        result += std::to_string(createInfo->pQueueFamilyIndices[i]);
+    }
+    return result;
+}
+
+static void M3aLogSwapchain(VkDevice device, const VkSwapchainCreateInfoKHR* createInfo, VkSwapchainKHR swapchain)
+{
+    if (!M3aEnabled() || createInfo == nullptr || swapchain == VK_NULL_HANDLE) return;
+    std::lock_guard lock(_m3aMutex);
+
+    M3aResolveDeviceFunctions(device);
+    uint32_t imageCount = 0;
+    VkResult imageResult = VK_ERROR_INITIALIZATION_FAILED;
+    if (_m3aGetSwapchainImagesKHR != nullptr)
+        imageResult = _m3aGetSwapchainImagesKHR(device, swapchain, &imageCount, nullptr);
+
+    LOG_INFO("M3A-OS: swapchain created sc={:X} dev={:X} phys={:X} hwnd={:X} extent={}x{} format={} colourSpace={} "
+             "usage=0x{:X} minImages={} actualImages={} vkGetSwapchainImagesKHR={} presentMode={} sharingMode={} "
+             "queueFamilies=[{}] oldSwapchain={:X}",
+             (UINT64) swapchain, (UINT64) device, (UINT64) _PD, (UINT64) _hwnd,
+             createInfo->imageExtent.width, createInfo->imageExtent.height, (int) createInfo->imageFormat,
+             (int) createInfo->imageColorSpace, (uint32_t) createInfo->imageUsage, createInfo->minImageCount,
+             imageCount, (int) imageResult, (int) createInfo->presentMode, (int) createInfo->imageSharingMode,
+             M3aQueueFamilyIndices(createInfo), (UINT64) createInfo->oldSwapchain);
+}
+
+static bool M3aShouldLogPresent(uint64_t serial, const VkPresentInfoKHR& info)
+{
+    return serial <= 16 || (serial % 300) == 0 || info.swapchainCount != 1 || info.waitSemaphoreCount != 1;
+}
